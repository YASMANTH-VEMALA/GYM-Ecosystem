# === Database ===
DATABASE_URL=postgresql://gymstack:gymstack@localhost:5432/gymstack
DIRECT_URL=postgresql://gymstack:gymstack@localhost:5432/gymstack

# === Supabase Auth ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_LOGO_BUCKET=gymstack-logos
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# === Razorpay ===
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# === Firebase (FCM) ===
FIREBASE_PROJECT_ID=gymstack
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gymstack.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# === WATI (WhatsApp) ===
WATI_API_URL=https://live-server-XXXXX.wati.io
WATI_API_KEY=your-wati-api-key

# === MSG91 (SMS) ===
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=GYMSTK
MSG91_OTP_TEMPLATE_ID=your-template-id

# === App Config ===
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PLATFORM_DOMAIN=mygymapp.in
QR_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ENABLE_CRON_JOBS=true

# === Email ===
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=GymOS <notifications@vormex.in>

# === PWA Web Push (generate once with `npx web-push generate-vapid-keys`) ===
WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:support@your-domain.com

# === One-time owner bootstrap (do not configure on production services) ===
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# BOOTSTRAP_OWNER_NAME=Gym Owner
# BOOTSTRAP_OWNER_PHONE=9876543210
# BOOTSTRAP_GYM_NAME=Example Fitness
# BOOTSTRAP_GYM_SLUG=example-fitness
# BOOTSTRAP_OWNER_PASSWORD=use-a-strong-password-or-let-the-script-generate-one
